# Copy to .env (never commit .env). Names only; values come from your Supabase project and service accounts.

# --- browser (safe to expose; RLS enforces access)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- worker / Edge Functions only (secrets: never in the browser or the repo)
SUPABASE_SERVICE_ROLE_KEY=
LINZ_API_KEY=
STATSNZ_ADE_KEY=
STATSNZ_DATAFINDER_KEY=
# OPENMETEO_API_KEY=        # only for commercial use
